{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hsi/ui": ["packages/ui/src"],
      "@hsi/shared-types": ["packages/shared-types/src"],
      "@hsi/config": ["packages/config/src"],
      "@hsi/database": ["packages/database/src"],
      "@hsi/ai-prompts": ["packages/ai-prompts/src"],
      "@hsi/classifiers": ["packages/classifiers/src"],
      "@hsi/traceability": ["packages/traceability/src"],
      "@hsi/source-connectors": ["packages/source-connectors/src"],
      "@hsi/security": ["packages/security/src"],
      "@hsi/simulation-engine": ["packages/simulation-engine/src"],
      "@hsi/world-models": ["packages/world-models/src"],
      "@hsi/counterfactuals": ["packages/counterfactuals/src"],
      "@hsi/timeline-engine": ["packages/timeline-engine/src"],
      "@hsi/research-agents": ["packages/research-agents/src"],
      "@hsi/evidence-engine": ["packages/evidence-engine/src"],
      "@hsi/source-intelligence": ["packages/source-intelligence/src"],
      "@hsi/scheduler": ["packages/scheduler/src"],
      "@hsi/temporal-intelligence": ["packages/temporal-intelligence/src"],
      "@hsi/causal-intelligence": ["packages/causal-intelligence/src"],
      "@hsi/counterfactual-engine": ["packages/counterfactual-engine/src"],
      "@hsi/decision-intelligence": ["packages/decision-intelligence/src"],
      "@hsi/outcome-intelligence": ["packages/outcome-intelligence/src"],
      "@hsi/calibration-engine": ["packages/calibration-engine/src"],
      "@hsi/trust-history": ["packages/trust-history/src"],
      "@hsi/recalibration-engine": ["packages/recalibration-engine/src"],
      "@hsi/intelligence-queue": ["packages/intelligence-queue/src"],
      "@hsi/research-orchestrator": ["packages/research-orchestrator/src"],
      "@hsi/publishing-engine": ["packages/publishing-engine/src"],
      "@hsi/distribution-engine": ["packages/distribution-engine/src"],
      "@hsi/consensus-engine": ["packages/consensus-engine/src"],
      "@hsi/collective-intelligence": ["packages/collective-intelligence/src"],
      "@hsi/forecast-engine": ["packages/forecast-engine/src"],
      "@hsi/scenario-engine": ["packages/scenario-engine/src"],
      "@hsi/executive-intelligence": ["packages/executive-intelligence/src"],
      "@hsi/operations-engine": ["packages/operations-engine/src"],
      "@hsi/performance-engine": ["packages/performance-engine/src"],
      "@hsi/contributor-network": ["packages/contributor-network/src"],
      "@hsi/trust-graph": ["packages/trust-graph/src"],
      "@hsi/outcome-attribution": ["packages/outcome-attribution/src"],
      "@hsi/lineage": ["packages/lineage/src"],
      "@hsi/cms-engine": ["packages/cms-engine/src"],
      "@hsi/beta-engine": ["packages/beta-engine/src"],
      "@hsi/launch-readiness": ["packages/launch-readiness/src"],
      "@hsi/site-builder": ["packages/site-builder/src"],
      "@hsi/entitlements": ["packages/entitlements/src"],
      "@hsi/billing": ["packages/billing/src"],
      "@hsi/saas-ops": ["packages/saas-ops/src"],
      "@hsi/source-collectors": ["packages/source-collectors/src"]
    }
  },
  "include": ["apps/**/*", "packages/**/*", "workspaces/**/*", "scripts/**/*"]
}
